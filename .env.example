# ============================================================
# .env.example — Bu faylni nusxalab .env deb saqlang
# Keyin GROQ_API_KEY ni o'z kalit bilan almashtiring
# ============================================================

# Groq API kalitingiz (https://console.groq.com/keys dan oling)
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# ============================================================
# VERCEL DA DEPLOY QILISH UCHUN:
# 1. vercel.com → loyiha → Settings → Environment Variables
# 2. Name: GROQ_API_KEY
# 3. Value: gsk_sizning_kalit_bu_yerga
# 4. Environment: Production, Preview, Development
# 5. Save → Redeploy
# ============================================================
