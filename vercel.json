{
    "version": 2,
    "functions": {
        "api/groq.js": {
            "memory": 128,
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "/api/groq",
            "dest": "/api/groq.js"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}
